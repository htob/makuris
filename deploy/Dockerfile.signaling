# 信令服务器多阶段构建
FROM rust:1-slim AS builder
WORKDIR /build
COPY Cargo.toml ./
COPY proto ./proto
COPY host ./host
COPY signaling-server ./signaling-server
RUN cargo build --release -p makuris-signaling

FROM debian:bookworm-slim
COPY --from=builder /build/target/release/makuris-signaling /usr/local/bin/makuris-signaling
EXPOSE 8443
CMD ["makuris-signaling"]