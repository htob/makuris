# makuris 部署配置模板 —— 复制为 scripts/.deploy.env 后按自己的环境填写。
#
# scripts/.deploy.env 已被 .gitignore 排除，不会进入版本库；
# 仓库里的部署脚本在启动时会自动加载它，未提供的项回落到脚本内置的通用默认值。

# ---- 云端信令服务器 ----
# 信令服务器的 SSH 目标
MAKURIS_CLOUD_SSH=root@your-server.example.com
# TURN 对外通告的公网 IP（留空则自动探测）
MAKURIS_TURN_PUBLIC_IP=203.0.113.10
# 客户端连接的信令地址
MAKURIS_SIGNALING=wss://your-server.example.com:8443/ws

# ---- 局域网 Windows 被控端 ----
# 被控端主机 SSH 目标
MAKURIS_HOST_SSH=user@192.168.1.223
# 被控端 Windows 用户名及其用户目录（影响远端脚本与 run.bat 的落盘路径）
MAKURIS_WIN_USER=user
MAKURIS_WIN_HOME=C:/Users/user
MAKURIS_WIN_DIR=C:/Users/user/makuris/target/release
MAKURIS_RUN_BAT=C:/Users/user/makuris-run.bat
# Windows 计划任务名
MAKURIS_TASK=MakurisHost
